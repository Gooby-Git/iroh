#version 460
// P5-1 final stage at DISPLAY resolution, after the upscaler: exposure, tone map, saturation, then the owner's thematic
// grade NvElementGrade (Navidson lib/navidson/elemental.glsl, LGPL grant: region constants and formula are the owner's).
// The tone curve is Iroh's own: the generic "x^a / (x^(a d) b + c)" form published by T. Lottes (GDC 2016, "Advanced
// Techniques and Optimization of HDR Color Pipelines"), with Iroh's parameters (not Complementary's). Out: display sRGB.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 1) readonly buffer In { vec4 hdr[]; };
layout(std430, set = 0, binding = 2) writeonly buffer O { vec4 ldr[]; };
layout(std430, set = 0, binding = 3) readonly buffer G { vec4 g[]; };   // g[0] weights (air, water, fire, earth); g[1] exposure, saturation, grade, strength; g[2] contrast a, shoulder d, hdrMax, midOut
layout(push_constant) uniform P { uint n; } pc;

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 curve(vec3 x) {
    float a = g[2].x, d = g[2].y, hdrMax = g[2].z, midIn = 0.18, midOut = g[2].w;
    float b = (-pow(midIn, a) + pow(hdrMax, a) * midOut) / ((pow(hdrMax, a * d) - pow(midIn, a * d)) * midOut);
    float c = (pow(hdrMax, a * d) * pow(midIn, a) - pow(hdrMax, a) * midOut * pow(midIn, a * d)) / ((pow(hdrMax, a * d) - pow(midIn, a * d)) * midOut);
    // on the max channel (hue-preserving), as Lottes recommends
    float m = max(max(x.r, x.g), x.b);
    if (m <= 0.0) return vec3(0.0);
    float t = pow(m, a) / (pow(m, a * d) * b + c);
    return x * (min(t, 1.0) / m);
}

vec3 srgb(vec3 c) { return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }

// ---- owner's elemental grade (Navidson), regions Air, Water, Fire, Earth
const vec3 RGB_E[4] = vec3[4](vec3(1.08, 0.98, 1.10), vec3(0.86, 1.00, 1.14), vec3(1.18, 0.96, 0.80), vec3(0.98, 1.06, 0.84));
const vec2 SC_E[4] = vec2[4](vec2(0.92, 0.95), vec2(1.04, 1.05), vec2(1.08, 1.10), vec2(1.08, 1.05));

vec3 tint(vec4 w, float amount, float strength) {
    vec3 t = vec3(1.0);
    for (int e = 0; e < 4; e++) t += w[e] * (RGB_E[e] - 1.0);
    t = max(t, vec3(0.05));
    t /= luma(t);
    return max(mix(vec3(1.0), t, amount * strength), vec3(0.0));
}

vec3 grade(vec3 color, vec4 w, float gradeAmt, float strength) {
    if (w.x + w.y + w.z + w.w < 0.002) return color;
    vec3 gc = color * tint(w, 1.0 / max(strength, 0.001), strength);
    gc = mix(gc, color, smoothstep(0.82, 1.0, luma(color)) * 0.55);
    vec2 sc = vec2(1.0);
    for (int e = 0; e < 4; e++) sc += w[e] * (SC_E[e] - 1.0);
    gc = mix(vec3(luma(gc)), gc, sc.x);
    gc = 0.4 * pow(max(gc, vec3(0.0)) / 0.4, vec3(sc.y));
    return max(mix(color, gc, gradeAmt * strength), vec3(0.0));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    vec3 c = max(hdr[i].rgb, vec3(0.0)) * g[1].x;
    c = curve(c);
    float l = luma(c);
    c = max(mix(vec3(l), c, g[1].y), vec3(0.0));
    c = clamp(srgb(clamp(c, 0.0, 1.0)), 0.0, 1.0);
    c = grade(c, g[0], g[1].z, g[1].w);
    ldr[i] = vec4(clamp(c, 0.0, 1.0), 1.0);
}

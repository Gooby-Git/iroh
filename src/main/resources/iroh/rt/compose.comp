#version 460
// (g) composition after the denoiser: emission + albedo * diffuse irradiance / pi (x (1 - F) under a specular lobe)
// + specular; water = its own radiance; sky pixels = sky + sun disc. Then fog (Navidson's role: an analytic height fog
// composed AFTER denoising so it is never smeared by history). Out: scene-linear HDR (tonemap happens after the upscaler).
layout(local_size_x = 8, local_size_y = 8) in;
#include "rt_common.glsl"
layout(std430, set = 0, binding = 9) readonly buffer Diff { vec4 diff[]; };
layout(std430, set = 0, binding = 10) readonly buffer Spec { vec4 spec[]; };
layout(std430, set = 0, binding = 11) writeonly buffer Out { vec4 outv[]; };

float fogAmount(vec3 o, vec3 d, float dist) {
    float a = fr.fog.x, b = fr.fog.y;
    float e0 = exp(-b * (o.y - fr.fog.z));
    float k = abs(d.y) > 1e-4 ? e0 * (1.0 - exp(-b * d.y * dist)) / (b * d.y) : e0 * dist;
    return 1.0 - exp(-a * k);
}

vec3 fogColor(vec3 d) {
    float s = pow(max(dot(d, fr.sunDir.xyz), 0.0), 8.0);
    return mix(fr.skyHorizon.rgb * 1.1, fr.sunE.rgb * 0.25, s * 0.5);
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= fr.dims.x || px.y >= fr.dims.y) return;
    uint i = px.y * fr.dims.x + px.x;
    Surf s = surface(px);
    vec3 c;
    float dist;
    if (!s.valid) {
        c = sky(s.dir) + sunDisc(s.dir);
        dist = 512.0;
    } else {
        vec4 m0 = mat0(s.tile), m1 = mat1(s.tile);
        dist = s.viewZ / dot(s.dir, fr.camFwd.xyz);
        if (m0.z != 0.0) c = spec[i].rgb;
        else {
            float kd = 1.0;
            if (m0.w != 0.0) kd = 1.0 - schlick(m1.w, max(dot(s.n, -s.dir), 0.0));
            c = m1.rgb + s.albedo / PI * diff[i].rgb * kd + (m0.w != 0.0 ? spec[i].rgb : vec3(0.0));
        }
    }
    if (fr.fog.w > 0.0) c = mix(c, fogColor(s.dir), fogAmount(fr.camPos.xyz, s.dir, dist));
    outv[i] = vec4(c, 1.0);
}

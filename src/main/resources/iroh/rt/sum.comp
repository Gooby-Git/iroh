#version 460
// Noisy diffuse irradiance = sun + block light + indirect (the denoiser's diffuse signal, demodulated by albedo).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 1) readonly buffer A { vec4 a[]; };
layout(std430, set = 0, binding = 2) readonly buffer B { vec4 b[]; };
layout(std430, set = 0, binding = 3) readonly buffer C { vec4 c[]; };
layout(std430, set = 0, binding = 4) writeonly buffer O { vec4 o[]; };
layout(push_constant) uniform P { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    o[i] = vec4(a[i].rgb + b[i].rgb + c[i].rgb, c[i].w);
}

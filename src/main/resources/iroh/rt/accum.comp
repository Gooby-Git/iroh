#version 460
// (h) stand-in denoiser: temporal accumulation with reprojection through the G-buffer motion vectors. Bilinear history
// taps, each kept only if its previous viewZ matches the reprojected surface (plane test) and its normal agrees;
// no valid tap = disocclusion = history reset. History length capped (maxHistory) so lighting changes fade in.
layout(local_size_x = 8, local_size_y = 8) in;
#include "rt_frame.glsl"
layout(std430, set = 0, binding = 1) readonly buffer FrameB { Frame fr; };
layout(std430, set = 0, binding = 2) readonly buffer GCur { uvec4 gcur[]; };
layout(std430, set = 0, binding = 3) readonly buffer GPrev { uvec4 gprev[]; };
layout(std430, set = 0, binding = 4) readonly buffer Sig { vec4 sig[]; };
layout(std430, set = 0, binding = 5) readonly buffer HistIn { vec4 hin[]; };
layout(std430, set = 0, binding = 6) writeonly buffer HistOut { vec4 hout[]; };
layout(push_constant) uniform P { float maxHistory; uint reset; } pc;
vec2 octWrap(vec2 v) { return (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0); }
vec3 octDecode(vec2 e) { e = e * 2.0 - 1.0; vec3 n = vec3(e.xy, 1.0 - abs(e.x) - abs(e.y)); if (n.z < 0.0) n.xy = octWrap(n.xy); return normalize(n); }
void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    uint W = fr.dims.x, H = fr.dims.y;
    if (px.x >= W || px.y >= H) return;
    uint i = px.y * W + px.x;
    uvec4 g = gcur[i];
    float vz = uintBitsToFloat(g.z);
    vec3 cur = sig[i].rgb;
    if (vz <= 0.0) { hout[i] = vec4(0.0); return; }
    vec3 n = octDecode(unpackUnorm2x16(g.x));
    vec2 ndc = (vec2(px) + 0.5) / vec2(W, H) * 2.0 - 1.0;
    vec4 far = fr.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(far.xyz / far.w - fr.camPos.xyz);
    vec3 pos = fr.camPos.xyz + dir * (vz / dot(dir, fr.camFwd.xyz));
    float expectZ = dot(pos - fr.prevCamPos.xyz, fr.prevCamFwd.xyz);
    vec2 prev = vec2(px) + 0.5 + unpackHalf2x16(g.w) - 0.5;   // previous position, texel-corner origin
    ivec2 b = ivec2(floor(prev));
    vec2 f = prev - vec2(b);
    vec4 acc = vec4(0.0);
    float wsum = 0.0;
    if (pc.reset == 0u) {
        for (int k = 0; k < 4; k++) {
            ivec2 q = b + ivec2(k & 1, k >> 1);
            if (q.x < 0 || q.y < 0 || q.x >= int(W) || q.y >= int(H)) continue;
            float w = ((k & 1) == 1 ? f.x : 1.0 - f.x) * ((k >> 1) == 1 ? f.y : 1.0 - f.y);
            uvec4 gp = gprev[uint(q.y) * W + uint(q.x)];
            float pz = uintBitsToFloat(gp.z);
            bool ok = pz > 0.0;
            if ((fr.dims.w & 8u) != 0u)
                ok = ok && abs(pz - expectZ) < 0.02 * expectZ + 0.02 && dot(octDecode(unpackUnorm2x16(gp.x)), n) > 0.9;
            if (!ok || w <= 0.0) continue;
            acc += hin[uint(q.y) * W + uint(q.x)] * w;
            wsum += w;
        }
    }
    float count = 0.0;
    vec3 hist = vec3(0.0);
    if (wsum > 1e-3) { hist = acc.rgb / wsum; count = acc.w / wsum; }
    count = min(count + 1.0, pc.maxHistory);
    hout[i] = vec4(mix(hist, cur, 1.0 / count), count);
}

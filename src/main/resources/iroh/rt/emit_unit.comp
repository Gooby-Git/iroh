#version 460
// Unit check of emitIrradiance (light-list sampling) against Lambert's exact polygon irradiance: one point per
// invocation (binding 9: pos, normal), K samples, unoccluded (points far above the scene).
layout(local_size_x = 64) in;
#include "rt_common.glsl"
layout(std430, set = 0, binding = 9) readonly buffer Pts { vec4 pts[]; };
layout(std430, set = 0, binding = 10) writeonly buffer Out { vec4 outv[]; };
layout(push_constant) uniform P { uint n; uint samples; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    vec3 x = pts[i * 2u].xyz, nn = pts[i * 2u + 1u].xyz;
    rngInit(uvec2(i, 7u), 0u, 5u);
    uint rays = 0u;
    vec3 acc = vec3(0.0), acc2 = vec3(0.0);
    for (uint k = 0u; k < pc.samples; k++) { vec3 e = emitIrradiance(x, nn, rays); acc += e; acc2 += e * e; }
    vec3 m = acc / float(pc.samples);
    outv[i] = vec4(m, (acc2.g / float(pc.samples) - m.g * m.g));
}

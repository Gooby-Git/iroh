#version 450
// Iroh P4-1a/P4-1b: upscaler inputs at world end, one invocation per render pixel.
//  - motion vectors (RG16F): prevUv - curUv in Iroh texel-UV axes (rows grow with NDC y; TemporalMath), unjittered;
//    FSR reads them with motionVectorScale = render size.
//      camera: reproject = PR_prev * T(camCur - camPrev) * PR_cur^-1 (CPU doubles): static world and sky.
//      objects (P4-1b): up to MAX_OBJ moving entities; a pixel whose camera-relative position lies in an object's box
//        uses that object's toPrevClip (rigid: previous position + body-yaw change, ObjectMotion.java).
//      hand (P4-1b): handReproject = (P_hand_prev W_prev) (P_hand_cur W_cur)^-1, W = view bob / hurt bob.
//  - merged depth (R32F) for the upscaler: hand depth where the hand is, else the scene depth.
//  - reactive and transparency-and-composition masks (R8): reactive from the change between the opaque copy (taken at
//    WorldRenderEvents.AFTER_ENTITIES) and the final colour (translucent terrain, particles, weather, clouds, GL-shim
//    draws after the copy point); T&C on translucent surfaces that wrote depth (water, glass, ice), on moving objects
//    (limb animation) and on the hand (swing, glint).
// Vanilla clears depth before the hand: depthTex holds only the hand, sceneDepthTex the copy taken at that clear.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const int MAX_OBJ = 64;
const float SKY_DEPTH = 0.999998; // TemporalMath.SKY_DEPTH: cleared 1.0 lies beyond JOML's infinity (1 - 1e-6)

layout(binding = 0) uniform sampler2D depthTex;
layout(binding = 1, rg16f) uniform writeonly image2D velocityImg;
layout(binding = 2, rgba8) uniform image2D colourImg;
layout(binding = 3) uniform sampler2D sceneDepthTex;
layout(binding = 4, std140) uniform Params {
    mat4 reproject;
    mat4 handReproject;
    mat4 invCurPR;
    vec4 jitter;   // xy jitter NDC, zw jitter px
    ivec4 info;    // xy size, z debug mode (0 none 1 velocity 2 reactive 3 depth 4 jitter), w flags
    ivec4 counts;  // x object count
    vec4 maskA;    // x reactive scale, y reactive max, z T&C translucent surface, w reactive weight on translucent surfaces
    vec4 maskB;    // x T&C hand
} pc;
struct Obj { vec4 lo; vec4 hi; mat4 toPrevClip; }; // lo.w = T&C value for the object's pixels
layout(binding = 5, std430) readonly buffer Objects { Obj obj[]; };
layout(binding = 6, r32f) uniform writeonly image2D mergedDepthImg;
layout(binding = 7, r8) uniform writeonly image2D reactiveImg;
layout(binding = 8, r8) uniform writeonly image2D tcImg;
layout(binding = 9) uniform sampler2D opaqueColourTex;
layout(binding = 10) uniform sampler2D opaqueDepthTex;

const int F_SEPARATE = 1, F_MASKS = 2, F_HAND = 4;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.info.x || p.y >= pc.info.y)
        return;
    int flags = pc.info.w;
    bool separate = (flags & F_SEPARATE) != 0;
    float endDepth = texelFetch(depthTex, p, 0).r;
    bool hand = separate && endDepth < 0.999999;
    float sceneRaw = separate ? texelFetch(sceneDepthTex, p, 0).r : endDepth;
    float depth = min(sceneRaw, SKY_DEPTH);
    vec2 size = vec2(pc.info.xy);
    vec2 ndc = (vec2(p) + 0.5) / size * 2.0 - 1.0 - pc.jitter.xy;

    vec4 prev;
    float tc = 0.0;
    bool objHit = false;
    if (hand) {
        prev = (flags & F_HAND) != 0 ? pc.handReproject * vec4(ndc, endDepth, 1.0) : vec4(ndc, endDepth, 1.0);
        tc = pc.maskB.x;
    } else {
        prev = pc.reproject * vec4(ndc, depth, 1.0);
        if (pc.counts.x > 0 && sceneRaw < 0.999999) {
            vec4 h = pc.invCurPR * vec4(ndc, sceneRaw, 1.0);
            if (abs(h.w) > 1e-12) {
                vec3 rel = h.xyz / h.w;
                int n = min(pc.counts.x, MAX_OBJ);
                for (int i = 0; i < n; i++) {
                    if (all(greaterThanEqual(rel, obj[i].lo.xyz)) && all(lessThanEqual(rel, obj[i].hi.xyz))) {
                        prev = obj[i].toPrevClip * vec4(rel, 1.0);
                        tc = obj[i].lo.w;
                        objHit = true;
                        break;
                    }
                }
            }
        }
    }
    vec2 mv = vec2(0.0);
    if (prev.w > 1e-9)
        mv = (prev.xy / prev.w - ndc) * 0.5;
    imageStore(velocityImg, p, vec4(mv, 0.0, 0.0));
    imageStore(mergedDepthImg, p, vec4(hand ? endDepth : sceneRaw));

    float reactive = 0.0;
    if ((flags & F_MASKS) != 0 && !hand) {
        vec3 cur = imageLoad(colourImg, p).rgb;
        vec3 opq = texelFetch(opaqueColourTex, p, 0).rgb;
        vec3 d = abs(cur - opq);
        reactive = min(pc.maskA.y, pc.maskA.x * max(d.r, max(d.g, d.b)));
        float od = texelFetch(opaqueDepthTex, p, 0).r;
        if (sceneRaw < od - 1e-7) {     // a translucent surface wrote depth in front of the opaque scene
            tc = max(tc, pc.maskA.z);
            reactive *= pc.maskA.w;     // it has its own depth and motion: lean on T&C, not reactivity
        }
    }
    imageStore(reactiveImg, p, vec4(reactive));
    imageStore(tcImg, p, vec4(tc));

#ifdef DEBUG_VIEW
    int mode = pc.info.z;
    if (mode == 1) {
        // black at rest; red = moving right (+u), green = left, blue = vertical; 8 render pixels of motion = full
        vec2 px = mv * size;
        imageStore(colourImg, p, vec4(clamp(px.x / 8.0, 0.0, 1.0), clamp(-px.x / 8.0, 0.0, 1.0), clamp(abs(px.y) / 8.0, 0.0, 1.0), 1.0));
    } else if (mode == 2) {
        // red = reactive, green = transparency & composition, blue = pixel took an object's motion
        imageStore(colourImg, p, vec4(reactive, tc, objHit ? 1.0 : 0.0, 1.0));
    } else if (mode == 3) {
        // merged depth (what the upscaler gets); distance = near / (1 - depth); grey over ~64 blocks, sky white
        float md = hand ? endDepth : sceneRaw;
        float dist = md >= 0.999999 ? 1e9 : 0.05 / max(1.0 - md, 1e-7);
        float g = 1.0 - exp(-dist / 64.0);
        imageStore(colourImg, p, vec4(g, g, g, 1.0));
    } else if (mode == 4) {
        // the scene stays; a 48x48 square in the lower left shows this frame's jitter (r = x + 0.5, g = y + 0.5)
        if (p.x < 48 && p.y < 48)
            imageStore(colourImg, p, vec4(pc.jitter.z + 0.5, pc.jitter.w + 0.5, 0.0, 1.0));
    }
#endif
}

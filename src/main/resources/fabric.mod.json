{
  "schemaVersion": 1,
  "id": "iroh",
  "version": "${version}",

  "name": "Iroh",
  "description": "Vulkan renderer for Minecraft 1.21.1, a fork of VulkanMod.",
  "authors": [
    "Elemore",
    "Collateral (VulkanMod)"
  ],
  "license": "LGPL-3.0-only",
  "contact": {
    "homepage": "",
    "sources": "https://github.com/xCollateral/VulkanMod"
  },

  "icon": "assets/vulkanmod/Vlogo.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vulkanmod.Initializer"
    ]
  },
  "mixins": [
    "iroh.mixins.json",
    "iroh-compat.mixins.json"
  ],
  "accessWidener" : "vulkanmod.accesswidener",

  "depends": {
    "fabricloader": ">=0.14.14",
    "minecraft": "1.21.1"
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  }
}
